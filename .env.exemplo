MQTT_broker = teste
MQTT_port = 1234
MQTT_client_id = teste
MQTT_username = teste
MQTT_password = teste
MQTT_topic_prefix = /space/device/esp32
# Intervalo de publicação em segundos
MQTT_publish_interval = 5
# QoS: 0, 1 ou 2
MQTT_qos = 1
# Usar TLS/SSL
MQTT_use_tls = false
# Usar autenticação
MQTT_use_auth = true
